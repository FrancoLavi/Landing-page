---
import { content, team, type Lang } from '../i18n/content';
import { SITE } from '../i18n/site';
import Atom3D from './Atom3D';
import ContactForm from './ContactForm';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
const base = lang === 'es' ? '' : '/en';
const otherHref = lang === 'es' ? '/en/' : '/';
const waHref = `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(lang === 'es' ? 'Hola Núcleo Software, quiero consultar por un proyecto.' : 'Hi Núcleo Software, I would like to ask about a project.')}`;
const shots = ['dashboard', 'stock', 'venta', 'caja', 'patrimonio'];
const initials =(n: string) => n.split(' ').filter(Boolean).slice(0, 2).map((s) => s[0]).join('');
---

<!-- NAV -->
<header class="fixed top-0 inset-x-0 z-50">
  <nav class="mx-auto max-w-6xl mt-4 mx-4 sm:mx-auto flex items-center justify-between glass rounded-full pl-5 pr-2 py-2">
    <a href={`${base}/`} class="flex items-center gap-2.5 font-semibold tracking-tight">
      <img src="/logo.png" alt="" width="26" height="26" class="rounded-sm" />
      <span>Núcleo<span class="text-brand-soft">.</span></span>
    </a>
    <ul class="hidden md:flex items-center gap-8 text-sm text-muted">
      <li><a class="hover:text-text transition" href="#services">{t.nav.services}</a></li>
      <li><a class="hover:text-text transition" href="#work">{t.nav.work}</a></li>
      <li><a class="hover:text-text transition" href="#about">{t.nav.about}</a></li>
      <li><a class="hover:text-text transition" href="#contact">{t.nav.contact}</a></li>
    </ul>
    <div class="flex items-center gap-2">
      <a href={otherHref} hreflang={lang === 'es' ? 'en' : 'es'} class="font-mono text-xs px-3 py-2 rounded-full text-muted hover:text-text transition" aria-label={lang === 'es' ? 'English version' : 'Versión en español'}>
        {lang === 'es' ? 'EN' : 'ES'}
      </a>
      <a href="#contact" class="btn btn-primary !py-2 !px-4 text-sm">{t.nav.cta}</a>
    </div>
  </nav>
</header>

<main>
  <!-- HERO -->
  <section class="relative min-h-svh flex items-center overflow-hidden pt-28 pb-16">
    <div class="absolute inset-0 bg-grid"></div>
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[900px] h-[600px] rounded-full bg-brand/20 blur-[140px]"></div>

    <div class="relative mx-auto max-w-6xl w-full px-6 grid lg:grid-cols-[1.1fr_1fr] gap-8 items-center">
      <div class="relative z-10">
        <p class="eyebrow mb-6 flex items-center gap-3" data-reveal>
          <span class="relative flex size-2"><span class="absolute inset-0 rounded-full bg-brand" style="animation:pulse-ring 2s infinite"></span><span class="size-2 rounded-full bg-brand"></span></span>
          {t.hero.eyebrow}
        </p>
        <h1 class="text-[clamp(2.3rem,7vw,5.6rem)] leading-[0.98] font-semibold tracking-tight" data-reveal data-delay="0.08">
          {t.hero.title.map((line, i) => (
            <span class:list={['block', i === 1 && 'text-gradient']}>{line}</span>
          ))}
        </h1>
        <p class="mt-7 max-w-xl text-lg text-muted leading-relaxed" data-reveal data-delay="0.16">{t.hero.subtitle}</p>
        <div class="mt-10 flex flex-wrap gap-3" data-reveal data-delay="0.24">
          <a href="#contact" class="btn btn-primary">{t.hero.primary} <span aria-hidden>→</span></a>
          <a href="#work" class="btn btn-ghost">{t.hero.secondary}</a>
        </div>
      </div>

      <div class="relative h-[300px] sm:h-[480px] lg:h-[620px] -mx-6 lg:mx-0" aria-hidden="true">
        <!-- Fallback estático mientras carga el 3D -->
        <img src="/logo.png" alt="" class="absolute inset-0 m-auto w-48 opacity-30 blur-[1px]" />
        <Atom3D client:idle />
      </div>
    </div>

    <a href="#services" class="absolute bottom-6 left-1/2 -translate-x-1/2 eyebrow !text-muted hidden sm:flex flex-col items-center gap-2" aria-label={t.hero.scroll}>
      {t.hero.scroll}
      <span class="block w-px h-8 bg-gradient-to-b from-brand to-transparent"></span>
    </a>
  </section>

  <!-- MARQUEE -->
  <div class="border-y border-line overflow-hidden py-5 bg-surface/50" aria-hidden="true">
    <div class="flex w-max gap-12 font-mono text-sm uppercase tracking-widest text-muted" style="animation:marquee 30s linear infinite">
      {[0, 1].map(() => (
        <div class="flex gap-12 shrink-0">
          {t.marquee.map((w) => (
            <span class="flex items-center gap-12">{w}<span class="text-brand">✦</span></span>
          ))}
        </div>
      ))}
    </div>
  </div>

  <!-- SERVICES -->
  <section id="services" class="relative py-28 sm:py-36">
    <div class="mx-auto max-w-6xl px-6">
      <p class="eyebrow mb-4" data-reveal>{t.services.eyebrow}</p>
      <h2 class="text-4xl sm:text-5xl font-semibold tracking-tight max-w-3xl" data-reveal>{t.services.title}</h2>

      <div class="mt-16 grid md:grid-cols-6 gap-4">
        {t.services.items.map((s, i) => (
          <article
            data-reveal data-delay={i * 0.06}
            class:list={['spot glass rounded-3xl p-8 flex flex-col justify-between min-h-[260px] transition hover:border-white/20', i === 0 ? 'md:col-span-4' : i === 3 ? 'md:col-span-4' : 'md:col-span-2']}
          >
            <span class="font-mono text-xs text-brand-soft border border-brand/40 rounded-full px-3 py-1 w-fit">{s.tag}</span>
            <div class="mt-12">
              <h3 class="text-2xl font-semibold tracking-tight">{s.title}</h3>
              <p class="mt-3 text-muted leading-relaxed max-w-md">{s.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- WORK -->
  <section id="work" class="relative py-28 sm:py-36 bg-surface/60 border-y border-line overflow-hidden">
    <div class="absolute right-0 top-1/3 w-[600px] h-[600px] rounded-full bg-brand/10 blur-[140px]"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <p class="eyebrow mb-4" data-reveal>{t.work.eyebrow}</p>
      <h2 class="text-4xl sm:text-5xl font-semibold tracking-tight max-w-3xl" data-reveal>{t.work.title}</h2>

      <div class="mt-14 grid lg:grid-cols-[0.8fr_1.2fr] gap-12 items-center">
        <div data-reveal>
          <p class="text-lg text-muted leading-relaxed">{t.work.text}</p>
          <ul class="mt-8 space-y-4">
            {t.work.points.map((p) => (
              <li class="flex gap-3"><span class="mt-2 size-1.5 rounded-full bg-brand shrink-0"></span><span>{p}</span></li>
            ))}
          </ul>
          <a href="#contact" class="btn btn-primary mt-10">{t.work.cta} <span aria-hidden>→</span></a>
          <p class="mt-5 text-sm text-muted">{t.work.note}</p>
        </div>

        <!-- Mockup de navegador: reemplazar por capturas reales en /public/concesionaria/ -->
        <div class="relative" data-reveal data-delay="0.1">
          <div class="absolute -inset-4 rounded-[2rem] bg-gradient-to-br from-brand/30 to-transparent blur-2xl"></div>
          <div class="relative hidden md:block rounded-2xl overflow-hidden border border-white/10 bg-ink shadow-2xl shadow-brand/10" data-parallax="-4">
            <div class="flex items-center gap-2 px-4 py-3 border-b border-line bg-surface-2">
              <span class="size-3 rounded-full bg-white/15"></span><span class="size-3 rounded-full bg-white/15"></span><span class="size-3 rounded-full bg-white/15"></span>
              <span class="ml-4 flex-1 rounded-md bg-white/5 px-3 py-1 text-xs font-mono text-muted truncate">concesionar.app</span>
            </div>
            <div class="relative aspect-[16/10] bg-surface" id="shots">
              {shots.map((s, i) => (
                <img
                  src={`/concesionaria/${s}.png`}
                  alt={`${t.work.title} — ${t.work.tabs[i]}`}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  data-shot={i}
                  class:list={['absolute inset-0 w-full h-full object-cover object-top transition-opacity duration-500', i === 0 ? 'opacity-100' : 'opacity-0']}
                />
              ))}
            </div>
          </div>
          <div class="relative mt-5 hidden md:flex flex-wrap gap-2" role="tablist" id="shot-tabs">
            {t.work.tabs.map((label, i) => (
              <button
                type="button" role="tab" data-tab={i} aria-selected={i === 0}
                class="font-mono text-xs px-4 py-2 rounded-full border border-line text-muted transition hover:text-text aria-selected:bg-brand aria-selected:border-brand aria-selected:text-white"
              >{label}</button>
            ))}
          </div>
          <img
            src="/concesionaria/mobile.png" alt={t.work.mobileAlt} loading="lazy"
            class="md:hidden mx-auto w-60 rounded-[2rem] border-4 border-ink shadow-2xl shadow-brand/30"
          />
          <img
            src="/concesionaria/mobile.png" alt="" aria-hidden="true" loading="lazy"
            class="hidden md:block absolute -bottom-10 -right-6 w-36 rounded-[1.6rem] border-4 border-ink shadow-2xl shadow-brand/30 rotate-3"
            data-parallax="-10"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="py-28 sm:py-36">
    <div class="mx-auto max-w-6xl px-6">
      <p class="eyebrow mb-4" data-reveal>{t.process.eyebrow}</p>
      <h2 class="text-4xl sm:text-5xl font-semibold tracking-tight max-w-3xl" data-reveal>{t.process.title}</h2>
      <ol class="mt-16 grid sm:grid-cols-2 lg:grid-cols-4 gap-px bg-line rounded-3xl overflow-hidden border border-line">
        {t.process.steps.map((s, i) => (
          <li class="bg-ink p-8 hover:bg-surface transition" data-reveal data-delay={i * 0.08}>
            <span class="font-mono text-brand-soft text-sm">{s.n}</span>
            <h3 class="mt-10 text-xl font-semibold">{s.title}</h3>
            <p class="mt-3 text-muted leading-relaxed">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="py-28 sm:py-36 bg-surface/60 border-y border-line">
    <div class="mx-auto max-w-6xl px-6">
      <p class="eyebrow mb-4" data-reveal>{t.about.eyebrow}</p>
      <div class="grid lg:grid-cols-2 gap-12">
        <h2 class="text-4xl sm:text-5xl font-semibold tracking-tight" data-reveal>{t.about.title}</h2>
        <p class="text-lg text-muted leading-relaxed lg:pt-3" data-reveal data-delay="0.08">{t.about.text}</p>
      </div>
      <div class="mt-16 grid sm:grid-cols-3 gap-4">
        {team.map((m, i) => (
          <article class="spot glass rounded-3xl p-8" data-reveal data-delay={i * 0.08}>
            <div class="size-16 rounded-2xl bg-gradient-to-br from-brand to-brand-deep grid place-items-center text-xl font-semibold shadow-lg shadow-brand/30">{initials(m.name)}</div>
            <h3 class="mt-8 text-xl font-semibold">{m.name}</h3>
            <p class="mt-1 font-mono text-sm text-muted">{m.role[lang]}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="relative py-28 sm:py-36 overflow-hidden">
    <div class="absolute left-1/2 -translate-x-1/2 bottom-0 w-[900px] h-[500px] rounded-full bg-brand/15 blur-[140px]"></div>
    <div class="relative mx-auto max-w-6xl px-6 grid lg:grid-cols-[0.9fr_1.1fr] gap-14">
      <div>
        <p class="eyebrow mb-4" data-reveal>{t.contact.eyebrow}</p>
        <h2 class="text-4xl sm:text-5xl font-semibold tracking-tight" data-reveal>{t.contact.title}</h2>
        <p class="mt-6 text-lg text-muted max-w-md" data-reveal>{t.contact.text}</p>
        <div class="mt-10 space-y-3" data-reveal>
          <p class="eyebrow !text-muted">{t.contact.orDirect}</p>
          <a href={`mailto:${SITE.email}`} class="block text-lg hover:text-brand-soft transition">{SITE.email}</a>
          <a href={waHref} target="_blank" rel="noopener" class="btn btn-ghost mt-2">
            <svg viewBox="0 0 24 24" class="size-5 fill-current" aria-hidden="true"><path d="M20.5 3.5A11.8 11.8 0 0 0 12 0C5.4 0 .1 5.3.1 11.9c0 2.1.6 4.1 1.6 5.9L0 24l6.4-1.7a11.9 11.9 0 0 0 5.6 1.4C18.6 23.7 24 18.4 24 11.8c0-3.200-1.2-6.100-3.500-8.300ZM12 21.700c-1.800 0-3.500-.5-5-1.400l-.4-.2-3.800 1 1-3.700-.2-.4a9.800 9.800 0 0 1-1.500-5.200C2.100 6.400 6.500 2 12 2c2.600 0 5.100 1 6.900 2.900a9.700 9.700 0 0 1 2.900 6.900c0 5.400-4.400 9.900-9.800 9.900Zm5.400-7.400c-.3-.1-1.700-.9-2-1-.3-.1-.5-.1-.7.100l-.9 1.100c-.2.200-.3.200-.6.100-1.700-.8-2.800-1.500-3.900-3.400-.3-.5.300-.5.900-1.600.1-.2 0-.4 0-.5l-.9-2.200c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.100-.8.400-.3.300-1 1-1 2.500s1.100 2.900 1.200 3.100c.2.200 2.100 3.200 5.100 4.500 1.900.8 2.600.9 3.600.7.600-.1 1.700-.7 2-1.400.2-.7.200-1.300.2-1.400-.1-.2-.3-.3-.6-.4Z"/></svg>
            WhatsApp · {SITE.whatsappDisplay}
          </a>
        </div>
      </div>

      <div class="glass rounded-3xl p-6 sm:p-10" data-reveal data-delay="0.1">
        <ContactForm
          client:visible
          email={SITE.email}
          whatsapp={SITE.whatsapp}
          web3formsKey={SITE.web3formsKey}
          t={t.contact}
        />
      </div>
    </div>
  </section>
</main>

<script>
  // Visor de capturas del proyecto (pestañas con auto-rotación)
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('#shot-tabs [data-tab]'));
  const imgs = Array.from(document.querySelectorAll<HTMLImageElement>('#shots [data-shot]'));
  let current = 0;
  let timer: number | undefined;
  const show = (n: number) => {
    current = n;
    imgs.forEach((im, i) => im.classList.toggle('opacity-0', i !== n));
    imgs.forEach((im, i) => im.classList.toggle('opacity-100', i === n));
    tabs.forEach((b, i) => b.setAttribute('aria-selected', String(i === n)));
  };
  const start = () => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    timer = window.setInterval(() => show((current + 1) % imgs.length), 5000);
  };
  tabs.forEach((b, i) => b.addEventListener('click', () => { clearInterval(timer); show(i); }));
  if (tabs.length) start();
</script>

<footer class="border-t border-line py-10">
  <div class="mx-auto max-w-6xl px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-muted">
    <div class="flex items-center gap-2.5">
      <img src="/logo.png" alt="" width="22" height="22" />
      <span>© {new Date().getFullYear()} Núcleo Software. {t.footer.rights}</span>
    </div>
    <span class="font-mono">{t.footer.made}</span>
  </div>
</footer>
